{
  "idleMinutes": 30,
  "defaultDir": "C:\\Users\\ashra",

  "//machine": "Label for this PC in the Discord control channel. Defaults to the hostname, purely cosmetic: identity comes from a MAC fingerprint, so two machines may share a name.",
  "machine": "desktop",

  "//controlChannel": "Channel the watchers use to see each other (created on first run). Default: claude-watchers.",
  "controlChannel": "claude-watchers",

  "//multiMachine": "Set to false to skip the control channel entirely and always wake locally.",
  "multiMachine": true,

  "//channels": "Optional: pin a channel to one machine. Everything else is decided automatically (the machine that has the session on disk wakes it).",
  "channels": {
    "library-ssr": "desktop",
    "server-logs": "laptop"
  }
}
